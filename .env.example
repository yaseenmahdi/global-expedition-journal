# Supabase browser/client configuration
# Replace these placeholders with values for your own Supabase project.
# Never place a Supabase service-role key in client-side environment variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
